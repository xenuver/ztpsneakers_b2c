# =============================================================
# ZTP Sneakers — Environment Variables Template
# =============================================================
# Salin file ini menjadi .env:
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# Kemudian isi setiap nilai yang bertanda <...> sesuai
# konfigurasi lokal / server Anda.
# JANGAN commit file .env ke repository!
# =============================================================


# ==========================================
# DJANGO CORE
# ==========================================

# Secret key — generate dengan: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<your-secret-key>

# Ubah ke False saat production
DEBUG=True


# ==========================================
# DATABASE — PostgreSQL
# ==========================================

DB_NAME=db_ztpsneakers
DB_USER=postgres
DB_PASSWORD=<your-postgres-password>
DB_HOST=localhost
DB_PORT=5432


# ==========================================
# MIDTRANS PAYMENT GATEWAY
# Daftar di: https://dashboard.midtrans.com
# Gunakan mode Sandbox selama development
# ==========================================

MIDTRANS_SERVER_KEY=<Mid-server-xxxxxxxxxxxxxxxx>
MIDTRANS_CLIENT_KEY=<Mid-client-xxxxxxxxxxxxxxxx>

# Ubah ke True saat go-live production
MIDTRANS_IS_PRODUCTION=False


# ==========================================
# RAJAONGKIR API — Kalkulasi Ongkir
# Daftar di: https://rajaongkir.com/akun/api
# ==========================================

RAJAONGKIR_API_KEY=<your-rajaongkir-api-key>

resent=re_HBvsKw1K_7qFsnYvwLoswWmVJ3VDdrNjb
